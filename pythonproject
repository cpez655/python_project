import random

def num_game():
    friend_num = random.randint(1,10)
    prompt = (
        "The next day, while bored in class, you and your friend decide to play the number guessing game. \n You're guessing! You get 3 tries. What's your guess (Integer 1-10)? \nEnter Here: "
    )

    for attempt in range(1, 4):
        guess = 0
        while True:
            try:
                guess = int(input(prompt))
            except ValueError:
                print("Please enter an integer from 1 to 10.")
                continue

            if 1 <= guess <= 10:
                break

            print("Please enter an integer from 1 to 10.")

        if guess == friend_num:
                print("You got it! +1 intellect, +1 social")
                player.change_stat("intellect", 1)
                player.change_stat("social", 1)
                return

        if guess < friend_num:
            print("Your friend's number is higher!")
        else:
            print("Your friend's number is lower!")

        if attempt < 3:
            prompt = "Try again: "
    player.change_stat("social", 1)
    print(f"Three guesses are up. You lost, but had fun with your friend. +1 Social \nYour friends number was {friend_num}.")

num_game()


