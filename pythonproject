#Player class - holds the player's name and stats
class Player:
    def __init__(self, name):
        self.name = name
        self.stats = {
            "health" : 0,
            "intellect" : 0,
            "confidence" : 0,
            "energy": 0,
            "social": 0
        }

    #Changes a stat by the given amount (uses a negative number to decrease)
    def change_stat(self, stat, amount):
        self.stats[stat] += amount

